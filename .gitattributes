# Normalize line endings: store LF in the repo and check out LF by default.
# This overrides any local core.autocrlf so every contributor gets consistent endings.
* text=auto eol=lf

*.sh text eol=lf

# Windows-specific scripts are the exception: keep CRLF in the working tree
# (PowerShell / cmd convention). The repo still stores LF.
*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binary assets: never normalize, diff, or merge.
*.png binary
*.ico binary
# Ship verbatim bytes: the portable recipe verifies the canonical Apache-2.0 hash.
/LICENSE -text
/NOTICE -text
