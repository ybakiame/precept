# ~/.config/acp/daemon.env  (chmod 600; never commit it)
# Read by acp-daemon.service. One shell-style word list; paths must not contain spaces.
#
# --allow-project NAME            exact project allowlist (repeat per project)
# --allow-root NAME=/abs/path     project root for that name (repeat per project)
# --database /abs/profile.sqlite3 select this existing Profile at start. Leave it out
#                                 until you have created one explicitly:
#   acp-query --runtime-dir ~/.local/state/acp/runtime \
#     --endpoint ~/.local/state/acp/runtime/control.sock profile create ~/.local/state/acp/profile.sqlite3
# --agent-config /abs/file        optional private session configuration
# --context-mcp /usr/bin/acp-mcp  optional trusted context bridge for opted-in sessions
#
# Write access is never configured here: enable it explicitly per daemon run with
# `acp-query profile write enable ... --confirm` or from the Desktop.
ACP_DAEMON_ARGS="--allow-project example --allow-root example=/home/USER/code/example"
