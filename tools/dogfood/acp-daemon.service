# ACP daemon as a systemd *user* service (private dogfooding).
# Installed to /usr/lib/systemd/user/acp-daemon.service by the Arch package.
# Enable explicitly:   systemctl --user enable --now acp-daemon.service
# The daemon never creates a Profile by itself. It selects one at start only if
# you asked for that ("Select at start" / acp-query profile select --remember).
# Projects are added from the Desktop, the TUI or acp-query (project add); the
# daemon keeps them in its state directory. There is nothing to configure here.
[Unit]
Description=ACP local daemon (Profile write owner; private dogfooding)
Documentation=file:///usr/share/doc/agent-control-plane/README.md
# A refusal (exit 2) is not retried; a crash is retried at most 3 times per minute.
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
# Creates ~/.local/state/acp with mode 0700: the daemon's state (projects.json,
# startup.json) and, inside it, the private runtime/.
StateDirectory=acp
StateDirectoryMode=0700
UMask=0077
# Fixed paths. Agent sessions: ~/.config/acp/agents.toml (absent: sessions off;
# see agents.toml.example). acp-mcp serves agents' read-only context.
ExecStart=/usr/bin/acp-daemon --state-dir %S/acp --runtime-dir %S/acp/runtime --endpoint %S/acp/runtime/control.sock --agent-config %E/acp/agents.toml --context-mcp /usr/bin/acp-mcp
# SIGTERM is a graceful stop: owned sessions are shut down, capabilities removed,
# the lease released. KillMode=mixed only reaches leftovers after the timeout.
KillMode=mixed
TimeoutStopSec=20
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=2

[Install]
WantedBy=default.target
