# ACP daemon as a systemd *user* service (private dogfooding).
# Installed to /usr/lib/systemd/user/acp-daemon.service by the Arch package.
# Enable explicitly:   systemctl --user enable --now acp-daemon.service
# The daemon never creates or selects a Profile by itself; select one explicitly
# (acp-query profile create/select) or name it with --database in daemon.env.
[Unit]
Description=ACP local daemon (Profile write owner; private dogfooding)
Documentation=file:///usr/share/doc/agent-control-plane/README.md
# A refusal (exit 2) is not retried; a crash is retried at most 3 times per minute.
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
# Creates ~/.local/state/acp with mode 0700; the daemon creates runtime/ in it privately.
StateDirectory=acp
StateDirectoryMode=0700
UMask=0077
# Operator configuration (projects, optional --database, session options):
# the packaged default /etc/acp/daemon.env (starts with no projects), then the
# optional per-user ~/.config/acp/daemon.env, whose values win.
Environment=ACP_DAEMON_ARGS=
EnvironmentFile=-/etc/acp/daemon.env
EnvironmentFile=-%E/acp/daemon.env
ExecStart=/usr/bin/acp-daemon --runtime-dir %S/acp/runtime --endpoint %S/acp/runtime/control.sock $ACP_DAEMON_ARGS
# SIGTERM is a graceful stop: owned sessions are shut down, capabilities removed,
# the lease released. KillMode=mixed only reaches leftovers after the timeout.
KillMode=mixed
TimeoutStopSec=20
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=2

[Install]
WantedBy=default.target
