# Precept daemon as a systemd *user* service (private dogfooding).
# Installed to /usr/lib/systemd/user/preceptd.service by the Arch package.
# Enable explicitly:   systemctl --user enable --now preceptd.service
# The daemon never creates a Profile by itself. It selects one at start only if
# you asked for that ("Select at start" / precept profile select --remember).
# Projects are added from the Desktop, the TUI or precept (project add); the
# daemon keeps them in its state directory. There is nothing to configure here.
[Unit]
Description=Precept local daemon (Profile write owner; private dogfooding)
Documentation=file:///usr/share/doc/precept/README.md
# A refusal (exit 2) is not retried; a crash is retried at most 3 times per minute.
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
# Creates ~/.local/state/precept with mode 0700: the daemon's state (projects.json,
# startup.json) and, inside it, the private runtime/.
StateDirectory=precept
StateDirectoryMode=0700
UMask=0077
# Fixed paths. MCP clients run /usr/bin/precept-mcp (beside the daemon) for agents'
# read-only context.
ExecStart=/usr/bin/preceptd --state-dir %S/precept --runtime-dir %S/precept/runtime --endpoint %S/precept/runtime/control.sock
# SIGTERM is a graceful stop: capabilities are removed,
# the lease released. KillMode=mixed only reaches leftovers after the timeout.
KillMode=mixed
TimeoutStopSec=20
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=2

[Install]
WantedBy=default.target
