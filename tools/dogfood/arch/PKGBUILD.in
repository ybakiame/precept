# Local Arch Linux package for private dogfooding; generated by tools/dogfood/arch-package.sh.
# Builds from a `git archive` of one clean commit, offline with the existing Cargo cache.
pkgname=precept
pkgver=@PKGVER@
pkgrel=1
pkgdesc='Precept local daemon, CLI, MCP server, harness hooks and Windows-GUI WSL bridge'
arch=(x86_64)
url='https://github.com/ybakiame/precept'
license=(Apache-2.0)
depends=(@DEPENDS@)
makedepends=(cargo)
optdepends=('git: live repository evidence')
options=(!debug !lto)
source=("precept-@SHORT@.tar" preceptd.service README.md)
sha256sums=(@SUMS@)

_bins=(preceptd precept precept-mcp precept-hook precept-bridge)

prepare() {
  cd "$srcdir/precept-@SHORT@"
  cargo fetch --locked --offline --target x86_64-unknown-linux-gnu
  cargo fetch --locked --offline --target x86_64-unknown-linux-gnu --manifest-path apps/Cargo.toml
}

build() {
  cd "$srcdir/precept-@SHORT@"
  export CARGO_TARGET_DIR="$srcdir/target"
  # Keep build-host paths out of the binaries.
  # The toolchain sysroot too: with rust-src installed, std paths resolve under ~/.rustup.
  local sysroot
  sysroot=$(rustc --print sysroot)
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=$srcdir=/precept/build --remap-path-prefix=${CARGO_HOME:-$HOME/.cargo}=/cargo --remap-path-prefix=$sysroot=/rust-sysroot"
  cargo build --frozen --release -p preceptd -p precept -p precept-mcp --bins
  cargo build --frozen --release --manifest-path apps/Cargo.toml \
    -p precept-ui-client --bin precept-bridge
}

package() {
  local b
  for b in "${_bins[@]}"; do
    install -Dm755 "$srcdir/target/release/$b" "$pkgdir/usr/bin/$b"
  done
  install -Dm644 "$srcdir/preceptd.service" "$pkgdir/usr/lib/systemd/user/preceptd.service"
  install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 "$srcdir/precept-@SHORT@/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/precept-@SHORT@/NOTICE" "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
}
