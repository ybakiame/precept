# Local Arch Linux package for private dogfooding; generated by tools/dogfood/arch-package.sh.
# Builds from a `git archive` of one clean commit, offline with the existing Cargo cache.
pkgname=agent-control-plane
pkgver=@PKGVER@
pkgrel=1
pkgdesc='ACP local daemon, CLI, MCP stdio server, TUI and Windows-GUI WSL bridge (private dogfooding build)'
arch=(x86_64)
url='https://github.com/ybakiame/agent-control-plane'
license=(Apache-2.0)
depends=(@DEPENDS@)
makedepends=(cargo)
optdepends=('git: live repository evidence')
options=(!debug !lto)
source=("acp-@SHORT@.tar" acp-daemon.service agents.toml.example README.md)
sha256sums=(@SUMS@)

_bins=(acp-daemon acp-query acp-mcp acp-wsl-bridge acp-nsh-tui)

prepare() {
  cd "$srcdir/acp-@SHORT@"
  cargo fetch --locked --offline --target x86_64-unknown-linux-gnu
  cargo fetch --locked --offline --target x86_64-unknown-linux-gnu --manifest-path apps/Cargo.toml
}

build() {
  cd "$srcdir/acp-@SHORT@"
  export CARGO_TARGET_DIR="$srcdir/target"
  # Keep build-host paths out of the binaries.
  # The toolchain sysroot too: with rust-src installed, std paths resolve under ~/.rustup.
  local sysroot
  sysroot=$(rustc --print sysroot)
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=$srcdir=/acp/build --remap-path-prefix=${CARGO_HOME:-$HOME/.cargo}=/cargo --remap-path-prefix=$sysroot=/rust-sysroot"
  cargo build --frozen --release -p acp-daemon -p acp-query -p acp-mcp --bins
  cargo build --frozen --release --manifest-path apps/Cargo.toml \
    -p acp-ui-client --bin acp-wsl-bridge
  cargo build --frozen --release --manifest-path apps/Cargo.toml \
    -p acp-ui --bin acp-nsh-tui --features acp-ui/tui
}

package() {
  local b
  for b in "${_bins[@]}"; do
    install -Dm755 "$srcdir/target/release/$b" "$pkgdir/usr/bin/$b"
  done
  install -Dm644 "$srcdir/acp-daemon.service" "$pkgdir/usr/lib/systemd/user/acp-daemon.service"
  install -Dm644 "$srcdir/agents.toml.example" "$pkgdir/usr/share/doc/$pkgname/agents.toml.example"
  install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 "$srcdir/acp-@SHORT@/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/acp-@SHORT@/NOTICE" "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
}
